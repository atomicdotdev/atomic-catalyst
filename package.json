                "h6FontWeight": {
                  "type": "string",
                  "default": "600",
                  "description": "Heading 6 font weight override."
                },
                "liveLineHeight": {
                  "type": "number",
                  "default": 1.5,
                  "minimum": 1,
                  "maximum": 3
                },
                "sourceLineHeight": {
                  "type": "number",
                  "default": 1.5,
                  "minimum": 1,
                  "maximum": 3
                }
              },
              "required": [
                "liveFont",
                "sourceFont",
                "liveFontSize",
                "sourceFontSize",
                "liveLineHeight",
                "sourceLineHeight"
              ],
              "additionalProperties": false
            },
            "activeLineBackground": {
              "type": "string",
              "default": "",
              "description": "Active-line background in Live and Source. Empty uses the default color; accepts theme colors or transparent. Read Only hides the highlight."
            }
          },
          "required": [
            "id",
            "name",
            "colors",
            "syntaxTokens",
            "fonts"
          ],
          "additionalProperties": false
        }
      }
    }
  },
  "scripts": {
    "install:all": "npm ci",
    "test": "bun test scripts/",
    "test:atomic": "bun test scripts/atomicIntent.test.mjs scripts/atomicIntentView.test.mjs scripts/atomicSourceControl.test.mjs scripts/atomicErrors.test.mjs scripts/atomicEvidence.test.mjs scripts/atomicDraftView.test.mjs scripts/atomicChangeMetadata.test.mjs scripts/atomicBlastRadius.test.mjs scripts/atomicFileDiff.test.mjs scripts/atomicPlanContext.test.mjs",
    "test:atomic:graph": "bun run build:extension:graph && bun scripts/atomicViewHostSmoke.mjs && bun scripts/atomicDiffHostSmoke.mjs && bun scripts/atomicGraphSmoke.mjs",
    "test:atomic:native": "bun run build:extension:atomic && node scripts/atomicNativeSmoke.mjs",
    "test:core": "bun test scripts/documentLifecycle.test.mjs",
    "preview": "bun scripts/preview.mjs",
    "test:browser": "bun scripts/browserSmoke.mjs",
    "package:vsix": "bun run build && mkdir -p releases && vsce package --no-dependencies --allow-missing-repository --out releases/",
    "typecheck": "tsc --noEmit && tsc -p webview/tsconfig.json --noEmit",
    "typecheck:webview": "tsc -p webview/tsconfig.json --noEmit",
    "build": "bun run build:webview && bun run build:extension",
    "build:webview": "rm -rf webview/dist && mkdir -p webview/dist webview/dist/katex && bun build webview/src/index.ts --target=browser --format=esm --splitting --minify --outdir=webview/dist && cp webview/src/styles.css webview/dist/index.css && cp node_modules/mermaid/dist/mermaid.min.js webview/dist/mermaid.min.js && cp node_modules/katex/dist/katex.min.css webview/dist/katex/katex.min.css && cp -R node_modules/katex/dist/fonts webview/dist/katex/fonts",
    "build:extension": "bun run build:extension:graph && bun run build:extension:atomic && bun run build:extension:main && bun run build:extension:export-runtime && bun run build:extension:puppeteer-runtime",
    "build:extension:graph": "bun build webview/src/atomicGraph.ts --target=browser --format=iife --minify --outfile=dist/atomic-graph.js && cp webview/src/atomicGraph.css dist/atomic-graph.css",
    "build:extension:atomic": "bun scripts/build-nodeatomic.mjs",
    "build:extension:main": "bun build src/extension.ts --target=node --format=cjs --minify --outfile=dist/extension.js -e vscode",
    "build:extension:main:debug": "bun build src/extension.ts --target=node --format=cjs --minify --outfile=dist/extension.js -e vscode --sourcemap=inline",
    "build:extension:export-runtime": "bun build src/export/runtime.ts --target=node --format=cjs --minify --outfile=dist/export-runtime.js",
    "build:extension:puppeteer-runtime": "bun build src/export/puppeteerRuntime.ts --target=node --format=cjs --minify --outfile=dist/puppeteer-runtime.js",
    "release:prep": "bun scripts/release-prep.mjs",
    "release:finalize": "bun scripts/release-prep.mjs finalize",
    "vscode:publish": "bun run build && vsce package --no-dependencies"
  },
