                },
                "namespace": {
                  "type": "string",
                  "format": "color"
                },
                "operator": {
                  "type": "string",
                  "format": "color"
                },
                "operatorKeyword": {
                  "type": "string",
                  "format": "color"
                },
                "punctuation": {
                  "type": "string",
                  "format": "color"
                },
                "functionName": {
                  "type": "string",
                  "format": "color"
                },
                "labelName": {
                  "type": "string",
                  "format": "color"
                },
                "definitionFunction": {
                  "type": "string",
                  "format": "color"
                },
                "definedVariable": {
                  "type": "string",
                  "format": "color"
                },
                "number": {
